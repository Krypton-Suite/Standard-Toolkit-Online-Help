{
  "metadata": [
    {
        "src": [
            {
                "files": [
                    "**/*.csproj"
                ],
                "exclude": [
                    "**/obj/**",
                    "**/bin/**",
                    "**/TestForm/**",
                    "**/Krypton.Standard.Toolkit/**"
                ],
                "src": "../../../../Standard-Toolkit/Source/Krypton Components/"
            }
        ],
        "dest": "api",
        "disableGitFeatures": true,
        "filter": "filterConfig.standard.yml",
        "properties": {
            "TargetFramework": "net8.0-windows"
        }
    },
    {
        "src": [
            {
                "files": [
                    "**/*.csproj"
                ],
                "exclude": [
                    "**/obj/**",
                    "**/bin/**",
                    "**/*.Tests/**",
                    "**/Examples/**",
                    "**/AutoUpdateCreator/**",
                    "**/ZipExtractor/**",
                    "**/Krypton.Toolkit.Suite.Extended.Ultimate/**",
                    "**/Krypton.Toolkit.Suite.Extended.Ultimate.Lite/**",
                    "**/Krypton - Backup.*"
                ],
                "src": "../../../../Extended-Toolkit/Source/Krypton Toolkit/"
            }
        ],
        "dest": "api-extended",
        "disableGitFeatures": true,
        "filter": "filterConfig.extended.yml",
        "properties": {
            "TargetFramework": "net8.0-windows"
        },
        "allowCompilationErrors": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/**.md",
          "api-extended/**.yml",
          "api-extended/**.md"
        ]
      },
      {
        "files": [
          "articles/**.md",
          "articles/**/toc.yml",
          "toc.yml",
          "articles/toc.yml",
          "*.md"
        ],
        "exclude": [
          "obj/**",
          "..\\/**"
        ]
      }
    ],
    "resource": [
        {
            "files": [
                "articles/**.png",
                "articles/**.bmp",
                "articles/**.gif",
                "articles/**.jpg",
                "articles/**.jpeg"
            ],
            "exclude": [
                "obj/**",
                "..\\/**"
            ]
        },
        {
            "files": [
                "https://github.com/Krypton-Suite/Documentation/blob/main/Assets/NuGet%20Package%20Icons/Krypton%20Standard%20Toolkit%20Stable.png",
                "https://raw.githubusercontent.com/Krypton-Suite/Standard-Toolkit/master/Assets/ICO/Main%20Icon/48%20x%2048/Krypton%20Stable.ico"
            ]
        }
    ],
    "overwrite": [
        {
            "files": [
                "apidoc/**.md"
            ],
            "exclude": [
                "obj/**",
                "..\\/**"
            ]
        }
    ],
    "globalMetadata": {
        "_appTitle": "Krypton Standard Toolkit Documentation",
        "_appFooter": "<span>Krypton Component Suite\nBSD 3-Clause License\n© Component Factory Pty Ltd, 2006 - 2016, All rights reserved.</span> <span>Modifications by Peter Wagner (aka PWagner1), Simon Coghlan (aka Smurf-IV), Giduac, Ahmed Abdelhameed, tobitege,  KamaniAR, Lesandro Gotardo (aka lesandrog), Jorge A. Avilés (aka mcpbcs) et al. 2017 - 2025. All rights reserved. <a href=\"https://github.com/Krypton-Suite\">https://github.com/Krypton-Suite</a></span>",
        "_appLogoPath": "Logo.png",
        "_appFaviconPath": "Krypton.ico",
        "_disableContribution": true
    },

    "dest": "..\\Output",
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "docfx-tmpl/src"
    ],
    "postProcessors": [],
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": true
  }
}
